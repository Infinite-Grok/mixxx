+# Mixxx Preview (unofficial): FDK-AAC is NOT built. The 0099 patch (moves libfdk_aac out of FFmpeg's nonfree list)
+# is therefore not applied either.
 
 vcpkg_from_github(
     OUT_SOURCE_PATH SOURCE_PATH
@@ -182,6 +181,13 @@
         "bmp"
     )
 
+    # Mixxx Preview (unofficial): no Fraunhofer FDK-AAC (GPL-incompatible). The Fedora lists enable libfdk_aac as the
+    # only AAC decoder, so drop it and enable FFmpeg's native LGPL AAC decoders instead (the native encoder is
+    # already in the list).
+    list(REMOVE_ITEM FFMPEG_ENABLE_DECODERS "libfdk_aac")
+    list(REMOVE_ITEM FFMPEG_ENABLE_ENCODERS "libfdk_aac")
+    list(APPEND FFMPEG_ENABLE_DECODERS "aac" "aac_latm")
+
     list(JOIN FFMPEG_ENABLE_DECODERS "," FFMPEG_ENABLE_DECODERS)
     list(JOIN FFMPEG_ENABLE_ENCODERS "," FFMPEG_ENABLE_ENCODERS)
     
@@ -507,7 +513,7 @@
